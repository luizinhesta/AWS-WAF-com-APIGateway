# ==========================================================================
# .gitignore - AWS WAF Security Lab 03 (SQL Injection)
# Ignora artefatos gerados, caches e arquivos que nao fazem parte do projeto.
# ==========================================================================

# --- Especificacao do Kiro (spec: requirements/design/tasks) ---------------
# Nao versionar a spec neste repositorio.
.kiro/

# --- Caches de ferramentas de teste ----------------------------------------
.pytest_cache/
.hypothesis/

# --- Bytecode e caches do Python -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# --- Ambientes virtuais Python (caso venham a ser criados) -----------------
.venv/
venv/
env/
ENV/

# --- Cobertura de testes / relatorios --------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Placeholder nao mais necessario (a pasta lambda ja tem codigo) --------
lambda/.gitkeep

# --- Arquivos de sistema operacional ---------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Arquivos de editores / IDEs -------------------------------------------
.vscode/
.idea/
*.swp
*~
